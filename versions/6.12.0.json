  "extra_modules": {
    "qtwebengine": {
      "_comment": "Not a qt5.git submodule in 6.12, and has no v6.12.0 tag. This commit is the tip of the 6.12 branch that opensource-qtmake6120-msvc2022-qtwebengine.bat uses.",
      "sha": "d4735ce2f841ffbe7cbac9ee7fd954f00514825f",
      "status": "addon",
      "depends": [
        "qtdeclarative"
      ],
      "recommends": [
        "qtpositioning",
        "qttools",
        "qtwebchannel"
      ],
      "_used_by": "Modules that have an optional QtWebEngine backend. They are built after QtWebEngine, and by the same job when QtWebEngine runs on a separate runner.",
      "used_by": [
        "qtwebview"
      ],
      "_cmake_args": "For all kits. Forcing the features on makes configure fail if a requirement is missing, instead of skipping the module.",
      "cmake_args": [
        "-DFEATURE_qtwebengine_build=ON",
        "-DFEATURE_qtwebengine_core_build=ON",
        "-DFEATURE_qtwebengine_widgets_build=ON",
        "-DFEATURE_qtwebengine_quick_build=ON"
      ],
      "_installs": "Path patterns (relative to the prefix) that the install must add. The item fails if one matches nothing.",
      "installs": [
        "lib/cmake/Qt6WebEngineCore/*",
        "lib/cmake/Qt6WebEngineWidgets/*",
        "lib/cmake/Qt6WebEngineQuick/*"
      ],
      "_third_party_licenses": "Chromium records its third-party code in README.chromium and LICENSE files, not in qt_attribution.json. The build copies every license file under these directories into the kit.",
      "third_party_licenses": [
        "src/3rdparty"
      ]
    }
  },
  "skip_modules": [
    "qtqa"
  ],
  "toolchains": {
    "_ffmpeg": "Every kit builds this FFmpeg (tools/build-ffmpeg.sh), and the Build FFmpeg workflow releases it for the kits in release. configure.common is the option list of Qt (coin/provisioning/common/shared/ffmpeg_config_options.txt in qt5.git) with two changes: avfilter stays on (qtmultimedia-deinterlace.patch), and the ffmpeg and ffprobe programs are built (--disable-ffplay instead of --disable-programs). The other lists add the options of Qt for that platform and the hardware encoders and ARIB captions of the released FFmpeg. parts lists the extra sources of each target; each part has the file with its license text. msvc builds zlib as a part (Qt gives its MSVC FFmpeg zlib too; other targets find the zlib of the system or of MinGW). mingw turns off iconv: MinGW 13.1 has only a static GNU libiconv, whose source the packages would have to offer too. No option may enable GPL or nonfree code; the build fails unless FFmpeg reports LGPL 2.1 or later. checks lists what the ffmpeg program of each target must report.",
    "ffmpeg": {
      "version": "7.1.5",
      "sha256": "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f",
      "url": "https://ffmpeg.org/releases/ffmpeg-{version}.tar.xz",
      "license": "COPYING.LGPLv2.1",
      "dav1d": {
        "version": "1.5.4",
        "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5",
        "url": "https://downloads.videolan.org/pub/videolan/dav1d/{version}/dav1d-{version}.tar.xz",
        "license": "COPYING",
        "notices": [
          "src/ext/x86/x86inc.asm"
        ]
      },
      "nv_codec_headers": {
        "version": "12.0.16.1",
        "sha256": "bfb3306f22c169fedcfc5489b344f414089eec796ffd528412677b0c872bc6e2",
        "url": "https://github.com/FFmpeg/nv-codec-headers/releases/download/n{version}/nv-codec-headers-{version}.tar.gz",
        "license": "include/ffnvcodec/nvEncodeAPI.h"
      },
      "libvpl": {
        "version": "2.17.0",
        "sha256": "4de3e2faf1e8307fb282e4a43f443191810f6a6b0a484fffa7995ba1c814c6ec",
        "url": "https://github.com/intel/libvpl/archive/refs/tags/v{version}.tar.gz",
        "file": "libvpl-{version}.tar.gz",
        "license": "LICENSE"
      },
      "amf_headers": {
        "version": "1.4.36",
        "sha256": "ec07ee21b820a73f5bae224e92fd3c492f52732d4885f0637f48189afdd87564",
        "url": "https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/v{version}/AMF-headers-v{version}.tar.gz",
        "license": "AMF/core/Version.h"
      },
      "zlib": {
        "version": "1.3.2",
        "sha256": "d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3",
        "url": "https://github.com/madler/zlib/releases/download/v{version}/zlib-{version}.tar.xz",
        "license": "LICENSE"
      },
      "libaribcaption": {
        "version": "1.1.2",
        "sha256": "649b50bde99272b97c66af2a8400163e2f84eae072d252daa26baaaf0866a1c2",
        "url": "https://github.com/xqq/libaribcaption/archive/refs/tags/v{version}.tar.gz",
        "file": "libaribcaption-{version}.tar.gz",
        "license": "LICENSE"
      },
      "_mingw_licenses": "The MinGW FFmpeg contains static libraries of MinGW 13.1 (the MinGW-w64 runtime, winpthreads, zlib, the GCC runtime). These files in <MinGW>/licenses/ have their license texts.",
      "mingw_licenses": [
        "winpthreads/COPYING",
        "mingw-w64/COPYING.MinGW-w64-runtime.txt",
        "zlib/copying.txt",
        "gcc/COPYING.RUNTIME",
        "gcc/COPYING3"
      ],
      "meson": "1.12.1",
      "ninja": "1.13.2",
      "cmake": "3.31.6",
      "android_api": 24,
      "parts": {
        "msvc": [
          "dav1d",
          "zlib",
          "nv_codec_headers",
          "libvpl",
          "amf_headers",
          "libaribcaption"
        ],
        "mingw": [
          "dav1d",
